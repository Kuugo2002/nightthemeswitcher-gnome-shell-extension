#~ msgstr "notify-send \"हैलो सनशाइन!\""

#~ msgid "notify-send \"Hello moonshine!\""
#~ msgstr "notify-send \"हैलो मूनशाइन!\""

#~ msgid "Support me with a donation"
#~ msgstr "दान देकर मेरा समर्थन करें"

#~ msgid ""
#~ "Your location will be used to calculate the current sunrise and sunset "
#~ "times. If you prefer, you can set a manual schedule. It will also be used "
#~ "when your location is unavailable."
#~ msgstr ""
#~ "आपके स्थान का उपयोग वर्तमान सूर्योदय और सूर्यास्त के समय की गणना करने के लिए किया "
#~ "जाएगा। यदि आप चाहें, तो आप मैन्युअल शेड्यूल सेट कर सकते हैं। इसका उपयोग तब भी किया "
#~ "जाएगा जब आपका स्थान अनुपलब्ध हो।"

#~ msgid "Themes"
#~ msgstr "थीम्स"

#~ msgid ""
#~ "GNOME has a built-in dark mode that the extension uses. Manually "
#~ "switching themes is discouraged and is only here for legacy reasons."
#~ msgstr ""
#~ "GNOME में एक अंतर्निर्मित डार्क मोड है जिसका एक्सटेंशन उपयोग करता है। मैन्युअल रूप से थीम "
#~ "बदलने को हतोत्साहित किया जाता है और यह केवल विरासती कारणों से है।"

#~ msgid "Switch GTK theme"
#~ msgstr "GTK थीम स्विच करें"

#~ msgid ""
#~ "Forcing a dark theme on applications not designed to support it can have "
#~ "undesirable side-effects such as unreadable text or invisible icons."
#~ msgstr ""
#~ "ऐसे अनुप्रयोगों पर डार्क थीम को जबरदस्ती थोपना जो इसके समर्थन के लिए डिज़ाइन नहीं "
#~ "किए गए हैं, के अवांछनीय दुष्प्रभाव हो सकते हैं जैसे कि अपठनीय पाठ या अदृश्य आइकन।"

#~ msgid "Day variant"
#~ msgstr "दिन का प्रकार"

#~ msgid "Night variant"
#~ msgstr "रात्रि संस्करण"

#~ msgid "Switch Shell theme"
#~ msgstr "Shell थीम स्विच करें"

#~ msgid "Switch icon theme"
#~ msgstr "आइकन थीम स्विच करें"

#~ msgid "Switch cursor theme"
#~ msgstr "कर्सर थीम स्विच करें"

