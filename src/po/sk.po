#: src/data/ui/BackgroundButton.ui:8
msgid "Change background"
msgstr "Zmeniť pozadie"

#: src/data/ui/BackgroundButton.ui:23
msgid "Select your background image"
msgstr "Vyberte svoj obrázok pozadia"

#: src/data/ui/BackgroundsPage.ui:9
msgid "Backgrounds"
msgstr "Pozadia"

#: src/data/ui/BackgroundsPage.ui:13
msgid ""
"Background switching is handled by the Shell, these settings allow you to "
"change the images it uses."
msgstr ""
"Prepínanie pozadia zabezpečuje Shell, tieto nastavenia umožňujú zmeniť "
"obrázky, ktoré používa."

#: src/data/ui/BackgroundsPage.ui:16
msgid "Day background"
msgstr "Denné pozadie"

#: src/data/ui/BackgroundsPage.ui:29
msgid "Night background"
msgstr "Nočné pozadie"

#: src/data/ui/CommandsPage.ui:9
msgid "Commands"
msgstr "Príkazy"

#: src/data/ui/CommandsPage.ui:13
msgid "Run commands"
msgstr "Spustiť príkazy"

#: src/data/ui/CommandsPage.ui:21 src/data/ui/SchedulePage.ui:21
msgid "Sunrise"
msgstr "Východ slnka"

#: src/data/ui/CommandsPage.ui:28 src/data/ui/SchedulePage.ui:34
msgid "Sunset"
msgstr "Západ slnka"

#: src/data/ui/ContributePage.ui:9
msgid "Contribute"
msgstr "Prispieť"

#: src/data/ui/ContributePage.ui:42
msgid "View the code and report issues"
msgstr "Zobraziť kód a nahlásiť problémy"

#: src/data/ui/ContributePage.ui:55
msgid "Contribute to the translation"
msgstr "Prispieť k prekladu"

#: src/data/ui/SchedulePage.ui:9
msgid "Schedule"
msgstr "Harmonogram"

#: src/data/ui/SchedulePage.ui:15
msgid "Manual schedule"
msgstr "Manuálny harmonogram"

#: src/data/ui/SchedulePage.ui:16
msgid "Use a manual schedule instead of the one computed from your location."
msgstr ""
"Namiesto harmonogramu vypočítaného z vašej polohy sa použije manuálny "
"harmonogram."

#: src/data/ui/SchedulePage.ui:51
msgid "Automatic schedule offset"
msgstr "Automatické posunutie plánu"

#: src/data/ui/SchedulePage.ui:52
msgid ""
"A positive value makes the night longer, a negative value makes the day "
"longer."
msgstr "Kladná hodnota predlžuje noc, záporná hodnota predlžuje deň."

#: src/data/ui/SchedulePage.ui:71
msgid "hours"
msgstr "hodín"

#: src/data/ui/SchedulePage.ui:84
msgid "Run the transition when an app is fullscreen"
msgstr "Spustiť prechod, keď je aplikácia na celú obrazovku"

#: src/data/ui/SchedulePage.ui:93
msgid "Keyboard shortcut"
msgstr "Klávesová skratka"

#: src/data/ui/ShortcutButton.ui:15
msgid "Choose…"
msgstr "Vybrať…"

#: src/data/ui/ShortcutButton.ui:32
msgid "Change keyboard shortcut"
msgstr "Zmeniť klávesovú skratku"

#: src/data/ui/ShortcutButton.ui:43
msgid "Clear"
msgstr "Vyčistiť"

#: src/data/ui/ShortcutButton.ui:78
msgid "Press your keyboard shortcut…"
msgstr "Stlačte vašu klávesovú skratku…"

#. Time separator (eg. 08:27)
#: src/data/ui/TimeChooser.ui:33 src/data/ui/TimeChooser.ui:91
msgid ":"
msgstr ":"

#: src/data/ui/TimeChooser.ui:52
msgid "AM"
msgstr "AM"

#: src/data/ui/TimeChooser.ui:58
msgid "PM"
msgstr "PM"

#: src/modules/Timer.js:285
msgid "Unknown Location"
msgstr "Neznáma poloha"

#: src/modules/Timer.js:286
msgid "A manual schedule will be used to switch the dark mode."
msgstr "Na prepnutie tmavého režimu sa použije manuálny harmonogram."

#: src/modules/Timer.js:290
msgid "Edit Manual Schedule"
msgstr "Upraviť manuálny harmonogram"

#: src/preferences/BackgroundButton.js:97
msgid "This image format is not supported."
msgstr "Tento formát obrázku nie je podporovaný."

#: src/preferences/BackgroundButton.js:109
msgid "Image files"
msgstr "Obrázkové súbory"
